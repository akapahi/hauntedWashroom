# Required
ELEVENLABS_API_KEY=

# Optional: shared secret the ESP32 must send as the X-Trigger-Token header
TRIGGER_TOKEN=

# Optional: password for the dashboard (any username); blank = no password (fine on a private LAN)
DASHBOARD_PASSWORD=

# Optional: audio device indexes from `python list_devices.py` (blank = system default).
# On the Pi with PulseAudio leave these blank, or point them at the "pulse"/"default" device.
AUDIO_INPUT_DEVICE=
AUDIO_OUTPUT_DEVICE=

# Optional: the mmWave presence sensor's serial port (e.g. /dev/ttyACM0 or COM5); blank = auto-detect, off = disabled
SENSOR_PORT=
# SENSOR_BAUD=115200

# Optional
# ENTITY_LLM=claude-sonnet-5
# ELEVENLABS_AGENT_ID=        # reuse an existing agent instead of looking it up / saving it in data/agent.json
# HOST=0.0.0.0
# PORT=8000
