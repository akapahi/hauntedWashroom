# Required
ELEVENLABS_API_KEY=

# Strongly recommended when hosted on the internet (Render):
# shared secret the ESP32 must send as the X-Trigger-Token header
TRIGGER_TOKEN=
# password for the dashboard (any username); without it anyone with the URL can control the entity
DASHBOARD_PASSWORD=

# Optional
# ENTITY_LLM=claude-sonnet-5
# ELEVENLABS_AGENT_ID=        # reuse an existing agent instead of looking it up / saving it in data/agent.json
# HOST=0.0.0.0
# PORT=8000                   # Render sets this itself
