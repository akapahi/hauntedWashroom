# Required
ELEVENLABS_API_KEY=

# Optional: shared secret the ESP32 must send as the X-Trigger-Token header
TRIGGER_TOKEN=

# Optional: audio device indexes from `python list_devices.py` (blank = system default)
AUDIO_INPUT_DEVICE=
AUDIO_OUTPUT_DEVICE=

# Optional
# ENTITY_LLM=claude-sonnet-5
# ELEVENLABS_AGENT_ID=        # reuse an existing agent instead of the one saved in data/agent.json
# HOST=0.0.0.0
# PORT=8000

# Optional: path to VoicemeeterRemote64.dll if Voicemeeter isn't in the default install location
# VOICEMEETER_DLL=
